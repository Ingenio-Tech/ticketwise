# ConnectWise PSA
CW_CLIENT_ID=your-connectwise-client-id
CW_COMPANY_URL=eu.myconnectwise.net
CW_CODE_BASE=v4_6_release
CW_COMPANY_ID=your-company-id
# No ConnectWise API keys: every call runs as the signed-in member.

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=moonshotai/kimi-k2.5:nitro

# App
NODE_ENV=production
HOSTNAME=0.0.0.0
